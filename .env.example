# Copia in `.env` (mai committare) e riempi con i valori del tuo progetto Supabase.
# Prefisso EXPO_PUBLIC_ = lette lato client (OK per anon key).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
EXPO_PUBLIC_SUPABASE_PROJECT_ID=xxxxxxxxxxxx
GOOGLE_MAPS_IOS_API_KEY=your_google_maps_ios_api_key
